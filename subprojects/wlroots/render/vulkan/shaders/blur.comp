#version 450

// Dual Kawase blur, with Hyprland's color treatment: it blurs in a gamma encoded
// space, adjusts contrast going in, and saturation, brightness and noise going out.

layout (local_size_x = 16, local_size_y = 16) in;

layout (set = 0, binding = 0) uniform sampler2D src;
layout (set = 0, binding = 1, rgba16f) uniform writeonly image2D dst;

layout (push_constant) uniform PushConstants {
	vec2 halfpixel;
	float offset;
	int mode;
	float contrast;
	float brightness;
	float vibrancy;
	float noise;
} data;

// Matches enum wlr_vk_blur_mode
#define BLUR_MODE_FIRST_DOWN 0
#define BLUR_MODE_DOWN 1
#define BLUR_MODE_UP 2
#define BLUR_MODE_LAST_UP 3

vec4 sample_src(vec2 uv) {
	vec4 color = textureLod(src, uv, 0);
	if (data.mode == BLUR_MODE_FIRST_DOWN) {
		color.rgb = pow(max(color.rgb, vec3(0)), vec3(1.0 / 2.2));
		color.rgb = max((color.rgb - 0.5) * data.contrast + 0.5, vec3(0));
	}
	return color;
}

vec4 down(vec2 uv) {
	vec2 o = data.halfpixel * data.offset;
	vec4 sum = sample_src(uv) * 4.0;
	sum += sample_src(uv - o);
	sum += sample_src(uv + o);
	sum += sample_src(uv + vec2(o.x, -o.y));
	sum += sample_src(uv - vec2(o.x, -o.y));
	return sum / 8.0;
}

vec4 up(vec2 uv) {
	vec2 o = data.halfpixel * data.offset;
	vec4 sum = sample_src(uv + vec2(-o.x * 2.0, 0.0));
	sum += sample_src(uv + vec2(-o.x, o.y)) * 2.0;
	sum += sample_src(uv + vec2(0.0, o.y * 2.0));
	sum += sample_src(uv + vec2(o.x, o.y)) * 2.0;
	sum += sample_src(uv + vec2(o.x * 2.0, 0.0));
	sum += sample_src(uv + vec2(o.x, -o.y)) * 2.0;
	sum += sample_src(uv + vec2(0.0, -o.y * 2.0));
	sum += sample_src(uv + vec2(-o.x, -o.y)) * 2.0;
	return sum / 12.0;
}

float hash(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 1689.1984);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

void main() {
	ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
	vec2 uv = (vec2(pos) + 0.5) / vec2(imageSize(dst));

	vec4 color = data.mode <= BLUR_MODE_DOWN ? down(uv) : up(uv);

	if (data.mode == BLUR_MODE_LAST_UP) {
		float luma = dot(color.rgb, vec3(0.2126, 0.7152, 0.0722));
		color.rgb = max(mix(vec3(luma), color.rgb, 1.0 + data.vibrancy), vec3(0));
		color.rgb *= data.brightness;
		color.rgb += (hash(vec2(pos)) - 0.5) * data.noise;
		color.rgb = pow(max(color.rgb, vec3(0)), vec3(2.2));
	}

	imageStore(dst, pos, color);
}
