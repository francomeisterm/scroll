#version 450

// Port of Hyprland's dual Kawase blur (blurprepare, blur1, blur2, blurFinish),
// HDR path included. It blurs the values SDR clients wrote: Hyprland's encoding
// is sRGB because it decodes them as sRGB, here both are gamma 2.2. It adjusts
// contrast and positive brightness going in, saturation on each step down, and
// negative brightness and noise going out. Level 0 of the destination image
// holds the prepared input and, at the end, the result.

layout (local_size_x = 16, local_size_y = 16) in;

layout (set = 0, binding = 0) uniform sampler2D src;
layout (set = 0, binding = 1, rgba16f) uniform writeonly image2D dst;

layout (push_constant) uniform PushConstants {
	vec2 halfpixel;
	float offset;
	int mode;
	float contrast;
	float brightness;
	float vibrancy;
	float noise;
	ivec2 origin;
	int passes;
} data;

// Matches enum wlr_vk_blur_mode
#define BLUR_MODE_PREPARE 0
#define BLUR_MODE_DOWN 1
#define BLUR_MODE_UP 2
#define BLUR_MODE_LAST_UP 3

vec3 gamma_encode(vec3 color) {
	return pow(max(color, vec3(0)), vec3(1.0 / 2.2));
}

vec3 gamma_decode(vec3 color) {
	return pow(max(color, vec3(0)), vec3(2.2));
}

// Above 1 is HDR content, which has no place on this curve
vec3 gain(vec3 color, float k) {
	vec3 x = clamp(color, 0.0, 1.0);
	vec3 t = step(0.5, x);
	vec3 y = mix(x, 1.0 - x, t);
	vec3 a = 0.5 * pow(2.0 * y, vec3(k));
	return mix(mix(a, 1.0 - a, t), color, greaterThan(color, vec3(1.0)));
}

vec4 prepare(vec4 color) {
	if (color.a <= 0.0) {
		return vec4(0);
	}
	color.rgb = gamma_encode(color.rgb / color.a);
	if (data.contrast != 1.0) {
		color.rgb = gain(color.rgb, data.contrast);
	}
	color.rgb *= max(1.0, data.brightness) * color.a;
	return color;
}

float double_circle_sigmoid(float x, float a) {
	a = clamp(a, 0.0, 1.0);
	if (x <= a) {
		return a - sqrt(a * a - x * x);
	}
	return a + sqrt(pow(1.0 - a, 2.0) - pow(x - 1.0, 2.0));
}

vec3 rgb_to_hsl(vec3 col) {
	float minc = min(col.r, min(col.g, col.b));
	float maxc = max(col.r, max(col.g, col.b));
	float delta = maxc - minc;

	float lum = (minc + maxc) * 0.5;
	float sat = 0.0;
	float hue = 0.0;

	if (lum > 0.0 && lum < 1.0) {
		sat = delta / ((lum < 0.5 ? lum : 1.0 - lum) * 2.0);
	}

	if (delta > 0.0) {
		vec3 masks = vec3(equal(vec3(maxc), col)) * vec3(notEqual(vec3(maxc), col.gbr));
		vec3 adds = vec3(0.0, 2.0, 4.0) + (col.gbr - col.brg) / delta;
		hue = dot(adds, masks) / 6.0;
		if (hue < 0.0) {
			hue += 1.0;
		}
	}

	return vec3(hue, sat, lum);
}

vec3 hsl_to_rgb(vec3 col) {
	const float third = 1.0 / 3.0;
	float hue = col.x;
	float sat = col.y;
	float lum = col.z;

	vec3 xt;
	if (hue < third) {
		xt = vec3(6.0 * (third - hue), 6.0 * hue, 0.0);
	} else if (hue < 2.0 * third) {
		xt = vec3(0.0, 6.0 * (2.0 * third - hue), 6.0 * (hue - third));
	} else {
		xt = vec3(6.0 * (hue - 2.0 * third), 0.0, 6.0 * (1.0 - hue));
	}
	xt = min(xt, 1.0);

	vec3 ct = 2.0 * sat * xt + 1.0 - sat;
	if (lum >= 0.5) {
		return (1.0 - lum) * ct + 2.0 * lum - 1.0;
	}
	return lum * ct;
}

vec4 vibrancy(vec4 color) {
	if (data.vibrancy == 0.0 || color.a <= 0.0) {
		return color;
	}
	vec3 rgb = color.rgb / color.a;
	if (max(rgb.r, max(rgb.g, rgb.b)) > 1.0) {
		return color;
	}

	const float a = 0.93;
	const float b = 0.11;
	const float c = 0.66;

	vec3 hsl = rgb_to_hsl(rgb);
	float brightness = double_circle_sigmoid(
		sqrt(dot(rgb * rgb, vec3(0.299, 0.587, 0.114))), 0.8);
	float boost = 0.0;
	if (hsl.y > 0.0) {
		boost = smoothstep(b - c * 0.5, b + c * 0.5, 1.0 -
			(pow(1.0 - hsl.y * cos(a), 2.0) + pow(1.0 - brightness * sin(a), 2.0)));
	}
	hsl.y = clamp(hsl.y + boost * data.vibrancy / float(data.passes), 0.0, 1.0);
	return vec4(hsl_to_rgb(hsl) * color.a, color.a);
}

vec4 down(vec2 uv) {
	vec2 o = data.halfpixel * data.offset;
	vec4 sum = textureLod(src, uv, 0) * 4.0;
	sum += textureLod(src, uv - o, 0);
	sum += textureLod(src, uv + o, 0);
	sum += textureLod(src, uv + vec2(o.x, -o.y), 0);
	sum += textureLod(src, uv - vec2(o.x, -o.y), 0);
	return vibrancy(sum / 8.0);
}

vec4 up(vec2 uv) {
	vec2 o = data.halfpixel * data.offset;
	vec4 sum = textureLod(src, uv + vec2(-o.x * 2.0, 0.0), 0);
	sum += textureLod(src, uv + vec2(-o.x, o.y), 0) * 2.0;
	sum += textureLod(src, uv + vec2(0.0, o.y * 2.0), 0);
	sum += textureLod(src, uv + vec2(o.x, o.y), 0) * 2.0;
	sum += textureLod(src, uv + vec2(o.x * 2.0, 0.0), 0);
	sum += textureLod(src, uv + vec2(o.x, -o.y), 0) * 2.0;
	sum += textureLod(src, uv + vec2(0.0, -o.y * 2.0), 0);
	sum += textureLod(src, uv + vec2(-o.x, -o.y), 0) * 2.0;
	return sum / 12.0;
}

float srgb_decode(float x) {
	return x <= 0.0031308 * 12.92 ? x / 12.92 : pow((x + 0.055) / 1.055, 2.4);
}

float hash(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 1689.1984);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

// Hyprland adds the noise in linear light, scaled by 80 nits of SDR white over
// the display's, which is around 400 nits here
vec4 finish(vec4 color, vec2 uv) {
	if (color.a <= 0.0) {
		return vec4(0);
	}
	float multiplier = min(1.0, data.brightness);
	float noise = (hash(uv) - 0.5) * data.noise * multiplier;
	color.rgb = gamma_decode(color.rgb / color.a * multiplier);
	color.rgb += sign(noise) * srgb_decode(abs(noise)) * 0.2;
	color.rgb = max(color.rgb, vec3(0)) * color.a;
	return color;
}

void main() {
	ivec2 pos = ivec2(gl_GlobalInvocationID.xy) + data.origin;
	vec2 uv = (vec2(pos) + 0.5) / vec2(imageSize(dst));

	vec4 color;
	if (data.mode == BLUR_MODE_PREPARE) {
		color = prepare(texelFetch(src, pos, 0));
	} else if (data.mode == BLUR_MODE_DOWN) {
		color = down(uv);
	} else if (data.mode == BLUR_MODE_UP) {
		color = up(uv);
	} else {
		color = finish(up(uv), uv);
	}

	imageStore(dst, pos, color);
}
